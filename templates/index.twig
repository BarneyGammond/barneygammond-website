<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta charset="utf-8" />
    <title>Barney Gammond</title>
    <meta 
        name="viewport" 
        content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, 
            viewport-fit=cover" 
    />
    <meta name="referrer" content="origin-when-cross-origin" />

    <link rel="icon" type="image/png" sizes="16x16" href="./assets/icons/bg-logo-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="./assets/icons/bg-logo-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="./assets/icons/bg-logo-180x180.png">
    <link rel="icon" type="image/svg+xml" href="/assets/icons/bg-logo-original.svg">

    <link rel="stylesheet" href="/dist/styles.css">
</head>
<body class="bg-gam-beige text-gam-text p-4">
    <main class="w-full sm:w-120 mx-auto">
        <h1 class="font-light text-3xl">{{siteName}}</h1>
        <p class="text-lg mb-4">A well-rounded Developer with experience in agile startups, strong people skills and a keen interest in sustainability.</p>
        {% set skillsEntries = craft.entries()
            .section('skills')
            .orderBy('score DESC')
            .all()
        %}
        {% if skillsEntries|length != 0 %}
        <div class="border-2 border-gam-text p-2 px-4 mb-4">
            <div class="flex flex-col gap-2">
                {% for entry in skillsEntries %}
                    {% set skillBarClasses = [
                        'absolute -top-0.5 border-2 border-gam-text',
                        entry.score < 10 ? 'w-' ~ entry.score ~ '/10' : 'w-full'
                    ] %}
                    <div class="flex items-center">
                        <p class="w-25">{{entry.title}}</p>
                        <div class="w-full h-0 relative">
                            <div class="w-full absolute -top-0.5 border-2 border-gam-text opacity-25"></div>
                            <div 
                                class="{{skillBarClasses|join(' ')}}">
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
        {% set jobsEntries = craft.entries()
            .section('jobs')
            .all()
        %}
        {% if jobsEntries|length != 0 %}
        <div class="ml-2 mt-2 pl-4 border-l-2 border-gam-text">
            {% for job in jobsEntries %}
                <div class="py-2">
                    <div class="relative flex justify-between">
                        <div class="absolute -left-5.5 top-2.5 border-5 border-gam-text w-0"></div>
                        <h2 class="font-bold text-xl">{{job.title}}</h2>
                        <p>{{job.startDate|date("M Y")}} - 
                            {% if job.currentRole %}
                                Present
                            {% else %}
                                {{job.endDate|date("M Y")}}
                            {% endif %}
                    </div>
                    <p class="font-bold mb-2">{{job.role}}</p>
                    {% set jobSkills = job.skills.all() %}
                    {% if jobSkills|length != 0 %}
                    <div class="flex gap-1 flex-wrap mb-2">
                    {% for skill in jobSkills %}
                        <p class="bg-gam-text text-gam-beige px-2 py-1">{{skill.title}}</p>
                    {% endfor %}
                    </div>
                    {% endif %}
                    {{job.description}}
                </div>
            {% endfor %}
        {% endif %}
        </div>
    </main>
</body>
</html>
